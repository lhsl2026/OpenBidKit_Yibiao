diff --git a/server/modules/preread/preread-codex-compat.spec.ts b/server/modules/preread/preread-codex-compat.spec.ts
new file mode 100644
--- /dev/null
+++ b/server/modules/preread/preread-codex-compat.spec.ts
@@ -0,0 +1,164 @@
+import {
+  normalizeExtractedFacts,
+  normalizeScoreFacts,
+  mergeExtractedFacts,
+  toFinding,
+} from './preread-parser.service';
+import { buildPrereadKnowledgeReport } from './preread-knowledge-report';
+import { renderPrereadKnowledgeMarkdown } from './preread-knowledge-renderer';
+import { normalizePrereadEvaluationCategory } from './preread-structured-metadata';
+import type { PrereadReportContext } from './preread-report.store';
+
+const record = (page: unknown = '23') => ({
+  statement: '投标人提供有效资质证明',
+  section: '资格审查',
+  quote: '投标人提供有效资质证明。',
+  page,
+  confidence: 0.95,
+});
+const source = {
+  taskId: 'compat-test',
+  documentId: 'doc',
+  fileName: '合成招标文件.pdf',
+  documentVersion: 1,
+  fileUrl: 'https://example.test/document.pdf',
+};
+
+describe('legacy preread records retain uncertainty', () => {
+  it('keeps qualitative and missing score confidence at zero and preserves supplementary source fields', () => {
+    const qualitative = { ...record(72), confidence: '高（原文残缺）', rule: '合成计分规则原文', evidenceRequirement: '合成证明材料原文' };
+    const missing = { ...record(73), procedure: '合成评审过程原文' } as Record<string, unknown>;
+    delete missing.confidence;
+    const raw = { 评分项: [qualitative], 评分办法: [missing] };
+    const original = JSON.stringify(raw);
+    const result = normalizeScoreFacts(raw);
+    expect(result.评分项[0]?.confidence).toBe(0);
+    expect(result.评分项[0]?.section).toContain('高（原文残缺）');
+    expect(result.评分项[0]?.section).toContain(qualitative.rule);
+    expect(result.评分项[0]?.section).toContain(qualitative.evidenceRequirement);
+    expect(result.待确认事项[0]?.confidence).toBe(0);
+    expect(result.待确认事项[0]?.section).toContain('未提供');
+    expect(result.待确认事项[0]?.section).toContain(missing.procedure);
+    const merged = mergeExtractedFacts([result]);
+    for (const item of [...merged.评分项, ...merged.待确认事项]) {
+      expect(toFinding('待确认事项', item, source).status).toBe('unconfirmed');
+      expect(item.quote).toBe(record().quote);
+    }
+    expect(JSON.stringify(raw)).toBe(original);
+    expect(() => normalizeExtractedFacts({ 项目事实: [qualitative] })).toThrow();
+  });
+
+  it('keeps score page arrays intact as unresolved locators without inventing a single page', () => {
+    const result = normalizeScoreFacts({ 评分办法: [{ ...record(), page: [72, 73], procedure: '原始过程' }] });
+    const item = result.待确认事项[0]!;
+    expect(item.page).toBeUndefined();
+    expect(item.section).toContain('[72,73]');
+    expect(item.section).toContain('原始过程');
+    expect(item.confidence).toBe(0.79);
+    expect(item.quote).toBe(record().quote);
+    for (const confidence of [-1, 2, {}]) {
+      expect(() => normalizeScoreFacts({ 评分项: [{ ...record(), confidence, page: [72, 73] }] })).toThrow();
+    }
+  });
+
+  it('does not treat inherited object keys as evaluation categories', () => {
+    for (const value of ['constructor', 'toString', '__proto__']) {
+      expect(normalizePrereadEvaluationCategory(value)).toBeUndefined();
+    }
+  });
+  it('preserves unknown score categories and amounts through the real batch merge', () => {
+    const raw = { 评分项: [
+      { ...record(23), evaluation: { category: '价格', maximumScore: 30, weightPercent: 30, reviewFocus: '报价' } },
+      { ...record('23—25'), statement: '主观评分原文', evaluation: { category: '主观分', maximumScore: 40, reviewFocus: '完整性' } },
+      { ...record(25), statement: '未知分值原文' },
+    ], 评分办法: [] };
+    const merged = mergeExtractedFacts([normalizeScoreFacts(raw)]);
+    expect(merged.评分项).toHaveLength(1);
+    const price = toFinding('评分项', merged.评分项[0]!, source);
+    expect(price.evaluation).toMatchObject({ category: 'price', maximumScore: 30, weightPercent: 30 });
+    expect(merged.待确认事项).toHaveLength(2);
+    expect(merged.待确认事项[0]?.section).toContain('主观分');
+    expect(merged.待确认事项[0]?.section).toContain('40');
+    for (const item of merged.待确认事项) {
+      expect(toFinding('待确认事项', item, source).status).toBe('unconfirmed');
+      expect(item.quote).toBe(record().quote);
+    }
+  });
+
+  it('converts a numeric page string and retains range/list locators without inventing a page', () => {
+    const raw = {
+      评分项: [record('23'), record('23—25'), record('23、27')],
+      评分办法: [{ ...record(), page: undefined }],
+    };
+    const original = JSON.stringify(raw);
+    const result = normalizeScoreFacts(raw);
+    expect(result.评分项[0]?.page).toBe(23);
+    for (const item of result.评分项.slice(1)) {
+      expect(item.page).toBeUndefined();
+      expect(item.confidence).toBeLessThan(0.8);
+      expect(String(item.section)).toContain('原始页码');
+      expect(toFinding('评分项', item, source).status).toBe('unconfirmed');
+    }
+    expect(JSON.stringify(raw)).toBe(original);
+  });
+
+  it('does not reject a whole fact category when its sole record has an ambiguous locator', () => {
+    const result = normalizeExtractedFacts({ 项目事实: [record('23—25')] });
+    expect(result.项目事实).toHaveLength(1);
+    expect(result.项目事实[0]?.section).toContain('23—25');
+    expect(result.项目事实[0]?.page).toBeUndefined();
+    expect(result.项目事实[0]?.confidence).toBe(0.79);
+  });
+
+  it('preserves empty-section records as explicitly unlocated and still rejects malformed content', () => {
+    const result = normalizeExtractedFacts({
+      项目事实: [{ ...record(), section: '' }],
+    });
+    expect(result.项目事实[0]?.section).toContain('待核实');
+    expect(result.项目事实[0]?.confidence).toBeLessThan(0.8);
+    expect(() =>
+      normalizeScoreFacts({ 评分项: [{ ...record(), quote: '' }] }),
+    ).toThrow();
+  });
+
+  it('builds report modules from legacy records without turning unknown booleans into false', () => {
+    const findings = ['资格条件', '商务条款', '废标风险'].map(
+      (findingType, i) => {
+        const finding = toFinding(findingType as never, record(23), source);
+        return { id: String(i), findingType, ...finding, ...finding.evidence };
+      },
+    );
+    const context: PrereadReportContext = {
+      task: { id: 'compat', title: '合成测试', priorityLevel: '普通' },
+      document: {
+        id: 'doc',
+        fileName: source.fileName,
+        version: 1,
+        completeTenderDocument: true,
+        parseStatus: 'parsed',
+      },
+      extractionComplete: true,
+      previousFindings: [],
+      manualActions: [],
+      findings,
+    };
+    expect(findings.every((f) => f.status === 'unconfirmed')).toBe(true);
+    expect(findings[0]?.qualification?.mandatory).toBeUndefined();
+    expect(
+      findings[0]?.qualification?.supplementableBeforeDeadline,
+    ).toBeUndefined();
+    expect(
+      findings[1]?.commercial?.supplementableBeforeDeadline,
+    ).toBeUndefined();
+    expect(findings[2]?.redline?.supplementableBeforeDeadline).toBeUndefined();
+    const report = buildPrereadKnowledgeReport(context);
+    expect(report.qualifications).toHaveLength(1);
+    expect(report.redlines).toHaveLength(1);
+    expect(report.redlines[0]?.requiredAction).toContain('待核实');
+    const markdown = renderPrereadKnowledgeMarkdown(report);
+    expect(markdown).toContain('待核实');
+    expect(markdown).not.toContain('当前不可补齐');
+    expect(markdown).not.toContain('当前不可补充');
+    expect(report.recommendation).not.toBe('建议参与');
+  });
+});
