# Copy to .env; keep secrets and private IDs out of Git.
BID_HOST=127.0.0.1
BID_PORT=4381
BID_API_KEY=
BID_COMPANY_ID=
BID_DELIVERY_MODE=disabled
BID_CHAT_ID=
BID_TEST_CHAT_IDS=
BID_OPERATOR_IDS=
BID_SOURCE_CHAT_IDS=
BID_SOURCE_SENDER_IDS=
# Optional user-identity history polling; uses existing CLI authorization without consuming the event bus.
BID_RADAR_POLL_ENABLED=false
BID_LARK_CLI_PATH=
BID_LARK_CLI_PROFILE=
BID_RADAR_START_AT=
# Optional bot-identity card stream. Use a dedicated profile for this app; ready confirms the CLI connection only.
# The developer console must also enable card.action.trigger callbacks; verify with an actual authorized click.
BID_CARD_SOURCE_ENABLED=false
BID_CARD_CLI_PROFILE=openbidkit-feishu
# Opt-in recovery of explicitly linked public Guizhou tender PDFs into this existing authorized Miaoda app.
BID_DOCUMENT_RECOVERY_ENABLED=false
BID_MIAODA_APP_ID=app_17agc8m97f2
BID_DOCUMENT_CLI_PROFILE=
# Opt-in docx report archive. Create/approve the destination folder before enabling.
BID_REPORT_ARCHIVE_ENABLED=false
BID_REPORT_FOLDER_TOKEN=
BID_REPORT_ALLOWED_FOLDER_TOKENS=
BID_REPORT_CLI_PROFILE=
BID_REPORT_CLI_IDENTITY=
BID_SUMMARY_HOUR=18
LARK_APP_ID=
LARK_APP_SECRET=
LARK_VERIFICATION_TOKEN=
LARK_ENCRYPT_KEY=
PREREAD_BASE_URL=
PREREAD_HANDOFF_API_KEY=
# This is a FULL Bearer header, separate from the handoff API key.
PREREAD_RELAY_AUTHORIZATION=
BID_VAULT_DATABASE=
# BidVault data directory; DB relative_path already contains files/.
BID_VAULT_FILES=
BID_VAULT_MAPPINGS=
# Replace the preread company profile from the verified local BidVault snapshot.
BID_COMPANY_PROFILE_SYNC_ENABLED=false
BID_RULES_FILE=
MODEL_PROVIDER=openai
MODEL_PROVIDER_BASE_URL=
MODEL_PROVIDER_API_KEY=
MODEL_PROVIDER_MODEL=
# Use the currently signed-in Codex CLI instead of a separately configured vendor API.
# The token below protects the local bridge; it is not a ChatGPT credential or vendor API key.
BID_MODEL_BACKEND=api
BID_CODEX_EXECUTABLE=
BID_CODEX_MODEL=gpt-6-astra
BID_CODEX_PORT=4383
BID_CODEX_TOKEN=
BID_CODEX_TIMEOUT_MS=240000
